# ===================================
# PricePing Frontend - Environment Variables Template
# ===================================
# Copy this file to .env inside the frontend directory:
#   cp .env.example .env

# Backend API base URL (empty if using Vite dev proxy, or e.g. http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
# Ensure Authorized JavaScript Origins includes http://localhost:5173 and your production domain
# Ensure Authorized Redirect URIs includes http://localhost:5173/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
