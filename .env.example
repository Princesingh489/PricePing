# ===================================
# PriceWatch India - Environment Variables
# ===================================
# Copy this file to .env and fill in values

# Database
DATABASE_URL=postgresql://pricewatch:password@db:5432/pricewatch_db
POSTGRES_USER=pricewatch
POSTGRES_PASSWORD=password
POSTGRES_DB=pricewatch_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@pricewatch.in
EMAILS_FROM_NAME=PriceWatch India

# Twilio (SMS & Calls) - Optional
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase (Push Notifications) - Optional
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Affiliate API Keys (optional - system works in demo mode without these)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
FLIPKART_AFFILIATE_TOKEN=

# Historical Data Providers
# Keepa API Key for Amazon verified price history (optional; fallback is PricePing's observation history)
KEEPA_API_KEY=

# App Settings
APP_NAME=PriceWatch India
APP_VERSION=1.0.0
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
PRICE_CHECK_INTERVAL_MINUTES=30
PRICE_CHECK_INTERVAL_HOURS=6
CROSS_STORE_SEARCH_ENABLED=true
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# Admin
FIRST_SUPERUSER_EMAIL=admin@pricewatch.in
FIRST_SUPERUSER_PASSWORD=adminpassword123
