# ===================================
# PricePing / PriceWatch India - Environment Variables Template
# ===================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database Configuration
# For Local SQLite: sqlite:///./pricewatch.db
# For Docker PostgreSQL: postgresql://pricewatch:password@db:5432/pricewatch_db
DATABASE_URL=postgresql://pricewatch:password@db:5432/pricewatch_db
POSTGRES_USER=pricewatch
POSTGRES_PASSWORD=password
POSTGRES_DB=pricewatch_db

# Redis & Celery Cache / Queue
REDIS_URL=redis://redis:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email (SMTP Alerts) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@pricewatch.in
EMAILS_FROM_NAME=PricePing India

# Twilio (SMS & Phone Calls) - Optional
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase (Mobile Push Notifications) - Optional
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Affiliate API Keys (Optional - works in scraping/direct mode without these)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
FLIPKART_AFFILIATE_TOKEN=

# Historical Data & Price History Providers (Optional)
# Keepa API Key for Amazon verified price history (optional; fallback is PricePing's verified observation history)
KEEPA_API_KEY=

# ScraperAPI (Optional - for high-concurrency external proxy scraping)
# Free key available at https://www.scraperapi.com (1000 requests/month)
SCRAPER_API_KEY=

# App & Engine Settings
APP_NAME=PricePing India
APP_VERSION=1.0.0
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
PRICE_CHECK_INTERVAL_MINUTES=30
PRICE_CHECK_INTERVAL_HOURS=6
CROSS_STORE_SEARCH_ENABLED=true
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# Initial Admin User Credentials
FIRST_SUPERUSER_EMAIL=admin@pricewatch.in
FIRST_SUPERUSER_PASSWORD=adminpassword123
